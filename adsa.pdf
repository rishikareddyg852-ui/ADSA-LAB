#include &lt;limits.h&gt;
#define MAX 100
#define INF INT_MAX
int n, m;
int graph[MAX][MAX];
int minDistance(int dist[], int visited[]) {
	int min = INF, min_index = -1;
	for (int v = 0; v &lt; n; v++) {
		if (!visited[v] &amp;&amp; dist[v] &lt;= min) {
			min = dist[v];
			min_index = v;
		}
	}
	return min_index;
}
void dijkstra(int src) {
	int dist[MAX];
	int visited[MAX];
	for(int i=0;i&lt;n;i++) {
		dist[i] = INF;
		visited[i] = 0;
	}
	dist[src] = 0;
	for (int count = 0; count &lt; n - 1; count++) {
		int u = minDistance(dist, visited);
		if (u == -1) break;
		visited[u] = 1;
		for (int v = 0; v &lt; n; v++) {
			if (!visited[v] &amp;&amp; graph[u][v] != INF &amp;&amp;
				dist[u] != INF &amp;&amp;
				dist[u] + graph[u][v] &lt; dist[v]) {
				dist[v] = dist[u] + graph[u][v];
			}
		}
	}
	for (int i = 0; i &lt; n; i++) {
		if (dist[i] == INF)
			printf("%d -1\n", i); // unreachable
		else
			printf("%d %d\n", i, dist[i]);
	}
}
int main() {
