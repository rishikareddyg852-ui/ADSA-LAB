				{
					pushEdge(u,v);
					if(disc[v]&lt;low[u]) low[u]=disc[v];
				}
			}
		}
}
void findBCCs()
{
	for(int i=0;i&lt;V;i++)
		{
			disc[i]=-1;
			parent[i]=-1;
		}
	time_dfs=0;
	bccCount=0;
	top=-1;
	for(int i=0;i&lt;V;i++)
		{
			if(disc[i]==-1)
			{
				BCCUtil(i);
				if(top&gt;=0)
				{
					bccCount++;
					top=-1;
				}
			}
		}
}
int main()
{
	scanf("%d %d",&amp;V,&amp;E);
	for(int i=0;i&lt;V;i++)
		for(int j=0;j&lt;V;j++)
			adj[i][j]=0;
	for(int i=0;i&lt;E;i++)
		{
			int u,v;
			scanf("%d %d",&amp;u,&amp;v);
			adj[u][v]=adj[v][u]=1;
		}
	findBCCs();
