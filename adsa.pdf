				<div class="pagedjs_page_content" style="column-width: 624px; column-gap: calc(var(--pagedjs-margin-right) + var(--pagedjs-margin-left));"><div><div class="container-xl" data-ref="d6e4ddbd-9146-4064-bb43-b9293b9bf6a0" data-split-from="d6e4ddbd-9146-4064-bb43-b9293b9bf6a0" data-split-to="d6e4ddbd-9146-4064-bb43-b9293b9bf6a0"><div class="page" data-ref="f806c3ff-e930-487e-99b9-b6bb883d2e01" data-split-from="f806c3ff-e930-487e-99b9-b6bb883d2e01" data-split-to="f806c3ff-e930-487e-99b9-b6bb883d2e01"><div data-ref="49587887-ab78-45aa-a172-1adbf0f7d072" data-id="lab-print" data-split-from="49587887-ab78-45aa-a172-1adbf0f7d072" data-split-to="49587887-ab78-45aa-a172-1adbf0f7d072"><div class="ct-print-new-page-after-always" data-ref="a825ef7e-8885-44ac-b240-9d4b16f9621b" data-break-after="always" data-split-from="a825ef7e-8885-44ac-b240-9d4b16f9621b" data-split-to="a825ef7e-8885-44ac-b240-9d4b16f9621b"><div class="mb-3" data-ref="d2b9b766-6bdd-433a-987a-e09161a06242" data-split-from="d2b9b766-6bdd-433a-987a-e09161a06242" data-split-to="d2b9b766-6bdd-433a-987a-e09161a06242"><div class="user-solution" style="page-break-inside: auto" data-ref="d1edd50c-c909-46ac-ac70-9566a104b625" data-undisplayed="undisplayed" data-split-to="d1edd50c-c909-46ac-ac70-9566a104b625" data-split-original="true"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="35d5c663-cee6-4c06-bb36-d1b8b7bb0428" data-undisplayed="undisplayed">biConnected.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="a817f893-86b1-4e13-96cb-31d415fcdcfd" data-undisplayed="undisplayed" data-split-to="a817f893-86b1-4e13-96cb-31d415fcdcfd" data-split-original="true" data-last-split-element="true" data-align-last-split-element="auto">#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;
#define MAX 100
int V,E;
int adj[MAX][MAX];
int disc[MAX],low[MAX],parent[MAX];
int time_dfs,bccCount;
struct Edge{int u,v;} stackEdges[MAX*MAX];
int top=-1;
void pushEdge(int u,int v)
{
	stackEdges[++top]=(struct Edge){u,v};
}
void popUntil(int u,int v)
{
	while(top&gt;=0)
		{
			struct Edge e=stackEdges[top--];
			if((e.u==u &amp;&amp; e.v==v)||(e.u==v &amp;&amp; e.v==u)) break;
		}
}
void BCCUtil(int u)
{
	int child=0;
	disc[u]=low[u]=++time_dfs;
	for(int v=0;v&lt;V;v++)
		{
			if(adj[u][v])
			{
				if(disc[v]==-1)
				{
					child++;
					parent[v]=u;
					pushEdge(u,v);
					BCCUtil(v);
					if(low[v]&gt;=disc[u])
					{
						bccCount++;
						popUntil(u,v);
					}
					if(low[v]&lt;low[u]) low[u]=low[v];
				}
</pre></div></div></div></div></div></div></div></div>
