#define max 20
#define inf 999999
int n,cost[max][max],visited[max],mincost=inf;
void tsp(int city,int count,int curr)
{
	if(count==n)
	{
		if(cost[city][0]!=-1)
		{
			int total=curr+cost[city][0];
			if(total&lt;mincost)
				mincost=total;
		}
		return;
	}
for(int i=1;i&lt;n;i++)
	{
		if(!visited[i]&amp;&amp;cost[city][i]!=-1)
		{
			visited[i]=1;
			tsp(i,count+1,curr+cost[city][i]);
			visited[i]=0;
		}
	}
}
int main()
{
	scanf("%d",&amp;n);
	for(int i=0;i&lt;n;i++)
		{
			for(int j=0;j&lt;n;j++)
				{
					scanf("%d",&amp;cost[i][j]);
				}
		}
	for(int i=0;i&lt;n;i++)
			visited[i]=0;
			visited[0]=1;
			tsp(0,1,0);
			if(mincost==inf)
				printf("-1\n");
			else
				printf("%d\n",mincost);
</pre></div></div></div></div></div></div></div></div>
