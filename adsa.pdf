// Main function with test case support
int main() {
	int t;
	scanf("%d", &amp;t);
	BTreeNode* root = createNode(t, true);
	int n, val;
	scanf("%d", &amp;n);
	for (int i = 0; i &lt; n; i++) {
		scanf("%d", &amp;val);
		insert(&amp;root, val);
	}
	inorder(root);
	int d;
	scanf("%d", &amp;d);
	for (int i = 0; i &lt; d; i++) {
		scanf("%d", &amp;val);
		deleteKey(&amp;root, val);
	}
	inorder(root);
	int target;
	scanf("%d\n", &amp;target);
	if (search(root, target))
		printf("Found\n");
	else
		printf("Not Found\n");

	return 0;
}</pre><br data-ref="c85fef8f-1836-4380-861c-78828c9ea37f"></div></div><div class="row" data-ref="9f7ef746-6eeb-445a-b3aa-f83de51faa60"><div class="col-12" data-ref="08e81a57-3815-426a-904b-09a530bb99e3"><h5 class="execResultsHeading text-center" data-ref="e7e3cd03-9797-4aeb-987d-802c4f04b2c6">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="b00fd793-2efd-4520-96b4-17b498933acb" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="e2edd09f-95c3-46b1-b9a1-47a332560820" data-split-to="e2edd09f-95c3-46b1-b9a1-47a332560820" data-split-original="true" data-last-split-element="true" data-align-last-split-element="auto"><div class="row execution-results-border" data-ref="b3daca0a-0865-4e3e-9ee2-0a77ccb069e7"><div class="col-12 p-2 text-center font-weight-bold" data-ref="845f08ae-6f68-491d-8560-7c955ab7edaf">Test Case - 1</div></div><div class="row execution-results-border" data-ref="f564ca13-fa2e-41af-8ea4-53f7571df662"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="89987822-9d55-4829-a1a4-dee8749c8cf2">User Output</div></div><div class="row execution-results-border" data-ref="95b8691f-1753-42a4-a89e-2012541f16b4"><div class="col-6" data-ref="8985aa53-ae09-4be0-820e-34106711e8e4"><span class="cmd" title="User Input" data-ref="ced438fe-0e04-4f2e-bd0f-df78980a4779">2</span></div></div><div class="row execution-results-border" data-ref="baefc7f8-c28e-4f40-a768-7820f9414104"><div class="col-6" data-ref="6e6f3f26-2f81-4253-8767-280466337dc8"><span class="cmd" title="User Input" data-ref="3ae2f290-b975-4399-ad68-0a5a1612588d">7</span></div></div></div></div></div></div></div></div></div>
