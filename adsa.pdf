void deletemin()
{

		if(size==0)
			return;
		heap[0]=heap[size-1];
		size--;
		heapifydown(0);
}
void printheap()
{
	for(int i=0;i&lt;size;i++)
		{
			printf("%d ",heap[i]);
		}
}
int main()
{
	int n,del,val;
	scanf("%d",&amp;n);
	for(int i=0;i&lt;n;i++)
		{
			scanf("%d",&amp;val);
			insert(val);
		}
	printheap();
	scanf("%d\n",&amp;del);
	for(int i=0;i&lt;del;i++)
		{
			deletemin();
		}
	printheap();
	printf("\n");
	return 0;
