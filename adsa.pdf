			<div class="pagedjs_area">
				<div class="pagedjs_page_content" style="column-width: 624px; column-gap: calc(var(--pagedjs-margin-right) + var(--pagedjs-margin-left));"><div><div class="container-xl" data-ref="d6e4ddbd-9146-4064-bb43-b9293b9bf6a0" data-split-from="d6e4ddbd-9146-4064-bb43-b9293b9bf6a0" data-split-to="d6e4ddbd-9146-4064-bb43-b9293b9bf6a0"><div class="page" data-ref="f806c3ff-e930-487e-99b9-b6bb883d2e01" data-split-from="f806c3ff-e930-487e-99b9-b6bb883d2e01" data-split-to="f806c3ff-e930-487e-99b9-b6bb883d2e01"><div data-ref="49587887-ab78-45aa-a172-1adbf0f7d072" data-id="lab-print" data-split-from="49587887-ab78-45aa-a172-1adbf0f7d072" data-split-to="49587887-ab78-45aa-a172-1adbf0f7d072"><div class="ct-print-new-page-after-always" data-ref="58c66fa8-4d71-4d29-b217-0483693c5fde" data-break-after="always" data-split-from="58c66fa8-4d71-4d29-b217-0483693c5fde" data-split-to="58c66fa8-4d71-4d29-b217-0483693c5fde" data-last-split-element="true" data-align-last-split-element="auto"><div class="mb-3" data-ref="8afed5d4-6e48-409f-bcb7-2a8c90cabb8f" data-split-from="8afed5d4-6e48-409f-bcb7-2a8c90cabb8f"><div class="user-solution" style="page-break-inside: auto" data-ref="697f7801-cf31-40c6-82cc-f150972d8b1c" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="d8b70b8d-8eb3-472b-9708-28d8a7f77ec5" data-undisplayed="undisplayed">dynamicKs.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="7f442204-ccae-4497-a4b7-75713fa58aa3" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;
int knapsack(int weights[],int profits[],int n,int m)
{
	int M[n+1][m+1];
	for(int i=0;i&lt;=n;i++)
		{
			for(int j=0;j&lt;=m;j++)
				{
					if(i==0||j==0)
					{
						M[i][j]=0;
					}
					else if(weights[i-1]&lt;=j)
						M[i][j]=(profits[i-1]+M[i-1][j-weights[i-1]]&gt;M[i-1][j])?(profits[i-1]+M[i-1][j-weights[i-1]]):M[i-1][j];
					else
						M[i][j]=M[i-1][j];
				}
		}
	return M[n][m];
}
int main()
{
	int n;
	scanf("%d",&amp;n);
	int weights[n],profits[n];
	for(int i=0;i&lt;n;i++)
		{
			scanf("%d",&amp;weights[i]);
		}
	for(int i=0;i&lt;n;i++)
		{
			scanf("%d",&amp;profits[i]);
		}
	int capacity;
	scanf("%d",&amp;capacity);
	int max=knapsack(weights,profits,n,capacity);
	printf("%d\n",max);
	return 0;
}</pre><br data-ref="32e5ecac-6bfa-4f70-b5ff-ab832493bb5e"></div></div></div></div></div></div></div></div>
