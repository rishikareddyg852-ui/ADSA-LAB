				<div class="pagedjs_page_content" style="column-width: 624px; column-gap: calc(var(--pagedjs-margin-right) + var(--pagedjs-margin-left));"><div><div class="container-xl" data-ref="d6e4ddbd-9146-4064-bb43-b9293b9bf6a0" data-split-from="d6e4ddbd-9146-4064-bb43-b9293b9bf6a0" data-split-to="d6e4ddbd-9146-4064-bb43-b9293b9bf6a0"><div class="page" data-ref="f806c3ff-e930-487e-99b9-b6bb883d2e01" data-split-from="f806c3ff-e930-487e-99b9-b6bb883d2e01" data-split-to="f806c3ff-e930-487e-99b9-b6bb883d2e01"><div data-ref="49587887-ab78-45aa-a172-1adbf0f7d072" data-id="lab-print" data-split-from="49587887-ab78-45aa-a172-1adbf0f7d072" data-split-to="49587887-ab78-45aa-a172-1adbf0f7d072"><div class="ct-print-new-page-after-always" data-ref="991c7da8-bfd2-45be-a9fe-d3fa39d8cd6c" data-break-after="always" data-split-from="991c7da8-bfd2-45be-a9fe-d3fa39d8cd6c" data-split-to="991c7da8-bfd2-45be-a9fe-d3fa39d8cd6c" data-last-split-element="true" data-align-last-split-element="auto"><div class="mb-3" data-ref="55431b86-2209-4b57-8ad8-acd9d2611768" data-split-from="55431b86-2209-4b57-8ad8-acd9d2611768"><div class="user-solution" style="page-break-inside: auto" data-ref="95ea22ae-ccee-42f1-8e0a-d5eab7ad2a68" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="851c8b5b-e6ea-4053-b5e6-b139ccc86ca4" data-undisplayed="undisplayed">dfs_directed_graph.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="79754181-2ff3-4a5b-aaad-f2722bb62d3e" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;
#define MAX 100
int adj[MAX][MAX],visited[MAX],adjcount[MAX];
int compare(const void *a,const void *b)
{
	return (*(int *)a-*(int *)b);
}
void dfs(int vertex)
{
	visited[vertex]=1;
	printf("%d ",vertex);
	for(int i=0;i&lt;adjcount[vertex];i++)
		{
			int neighbour=adj[vertex][i];
			if(!visited[neighbour])
			{
				dfs(neighbour);
			}
		}
}
int main()
{
	int vertices,edges,start;
	scanf("%d %d",&amp;vertices,&amp;edges);
	for(int i=0;i&lt;vertices;i++)
		{
			adjcount[i]=0;
			visited[i]=0;
		}
	for(int i=0;i&lt;edges;i++)
		{
		int u,v;
		scanf("%d %d",&amp;u,&amp;v);
		adj[u][adjcount[u]++]=v;
		}
	for(int i=0;i&lt;vertices;i++)
		{
			qsort(adj[i],adjcount[i],sizeof(int),compare);
		}
	scanf("%d",&amp;start);
	dfs(start);
	return 0;
}</pre><br data-ref="75fca01a-c6ff-4f51-b3a8-3f7e822633b0"></div></div></div></div></div></div></div></div>
