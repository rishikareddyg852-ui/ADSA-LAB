void merge(int arr[],int low,int mid,int high)
{
	int temp[1000];
	int i=low;
	int j=mid+1;
	int k=low;
	while(i&lt;=mid &amp;&amp; j&lt;=high)
		{
			if(arr[i]&lt;=arr[j])
				temp[k++]=arr[i++];
			else
				temp[k++]=arr[j++];
		}
	while(i&lt;=mid)
			temp[k++]=arr[i++];
	while(j&lt;=high)
		temp[k++]=arr[j++];

	for(i=low;i&lt;=high;i++)
	{
		arr[i]=temp[i];
	}
}

	void mergesort(int arr[],int low,int high)
	{
		if(low&lt;high)
		{
			int mid=(low+high)/2;
			mergesort(arr,low,mid);
			mergesort(arr,mid+1,high);
			merge(arr,low,mid,high);
		}
	}
int main()
{
	int n,i;
	scanf("%d",&amp;n);
	int arr[n];
	for(i=0;i&lt;n;i++)
		{
			scanf("%d",&amp;arr[i]);
		}
