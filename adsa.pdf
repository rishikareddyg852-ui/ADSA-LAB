			<div class="pagedjs_area">
				<div class="pagedjs_page_content" style="column-width: 624px; column-gap: calc(var(--pagedjs-margin-right) + var(--pagedjs-margin-left));"><div><div class="container-xl" data-ref="d6e4ddbd-9146-4064-bb43-b9293b9bf6a0" data-split-from="d6e4ddbd-9146-4064-bb43-b9293b9bf6a0" data-split-to="d6e4ddbd-9146-4064-bb43-b9293b9bf6a0"><div class="page" data-ref="f806c3ff-e930-487e-99b9-b6bb883d2e01" data-split-from="f806c3ff-e930-487e-99b9-b6bb883d2e01" data-split-to="f806c3ff-e930-487e-99b9-b6bb883d2e01"><div data-ref="49587887-ab78-45aa-a172-1adbf0f7d072" data-id="lab-print" data-split-from="49587887-ab78-45aa-a172-1adbf0f7d072" data-split-to="49587887-ab78-45aa-a172-1adbf0f7d072"><div class="ct-print-new-page-after-always" data-ref="c2b7bb35-1273-4bdc-b927-a651482a5ed6" data-break-after="always" data-split-from="c2b7bb35-1273-4bdc-b927-a651482a5ed6" data-split-to="c2b7bb35-1273-4bdc-b927-a651482a5ed6"><div class="mb-3" data-ref="4b130858-839d-4650-b7a0-c2a6a9e84393" data-split-from="4b130858-839d-4650-b7a0-c2a6a9e84393" data-split-to="4b130858-839d-4650-b7a0-c2a6a9e84393"><div class="user-solution" style="page-break-inside: auto" data-ref="e9132c01-b9de-4b93-b872-e8bdeb056b7c" data-undisplayed="undisplayed" data-split-to="e9132c01-b9de-4b93-b872-e8bdeb056b7c" data-split-original="true"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="a0fb17ad-524c-4a70-afe7-eb66f3f5ec2a" data-undisplayed="undisplayed">Btreemain.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="99e6b4cf-5db9-4ced-a30e-b84af1d3ea29" data-undisplayed="undisplayed" data-split-to="99e6b4cf-5db9-4ced-a30e-b84af1d3ea29" data-split-original="true" data-last-split-element="true" data-align-last-split-element="auto">#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;
#include &lt;stdbool.h&gt;

typedef struct BTreeNode {
	int *keys;
	int t;
	struct BTreeNode **C;
	int n;
	bool leaf;
} BTreeNode;

// Create a new node
BTreeNode* createNode(int t, bool leaf) {
	BTreeNode* node = (BTreeNode*)malloc(sizeof(BTreeNode));
	node-&gt;t = t;
	node-&gt;leaf = leaf;
	node-&gt;keys = (int*)malloc((2 * t - 1) * sizeof(int));
	node-&gt;C = (BTreeNode**)malloc((2 * t) * sizeof(BTreeNode*));
	node-&gt;n = 0;
	return node;
}

// Inorder traversal (no trailing dot)
void inorder(BTreeNode* root) {
	if (!root) return;
	for (int i = 0; i &lt; root-&gt;n; i++) {
		if (!root-&gt;leaf)
			inorder(root-&gt;C[i]);
		printf("%d ", root-&gt;keys[i]);
	}
	if (!root-&gt;leaf)
		inorder(root-&gt;C[root-&gt;n]);
}

// Search a key
bool search(BTreeNode* root, int k) {
	int i = 0;
	while (i &lt; root-&gt;n &amp;&amp; k &gt; root-&gt;keys[i])
		i++;
	if (i &lt; root-&gt;n &amp;&amp; root-&gt;keys[i] == k)
		return true;
	if (root-&gt;leaf)
		return false;
