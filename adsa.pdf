				<div class="pagedjs_page_content" style="column-width: 624px; column-gap: calc(var(--pagedjs-margin-right) + var(--pagedjs-margin-left));"><div><div class="container-xl" data-ref="d6e4ddbd-9146-4064-bb43-b9293b9bf6a0" data-split-from="d6e4ddbd-9146-4064-bb43-b9293b9bf6a0" data-split-to="d6e4ddbd-9146-4064-bb43-b9293b9bf6a0"><div class="page" data-ref="f806c3ff-e930-487e-99b9-b6bb883d2e01" data-split-from="f806c3ff-e930-487e-99b9-b6bb883d2e01" data-split-to="f806c3ff-e930-487e-99b9-b6bb883d2e01"><div data-ref="49587887-ab78-45aa-a172-1adbf0f7d072" data-id="lab-print" data-split-from="49587887-ab78-45aa-a172-1adbf0f7d072" data-split-to="49587887-ab78-45aa-a172-1adbf0f7d072"><div class="ct-print-new-page-after-always" data-ref="da461ea8-07db-4093-bb88-83144d414185" data-break-after="always" data-split-from="da461ea8-07db-4093-bb88-83144d414185" data-split-to="da461ea8-07db-4093-bb88-83144d414185" data-last-split-element="true" data-align-last-split-element="auto"><div class="mb-3" data-ref="a845f68e-5b9c-4b73-8a73-71c2071b0372" data-split-from="a845f68e-5b9c-4b73-8a73-71c2071b0372"><div class="user-solution" style="page-break-inside: auto" data-ref="f03c4bbc-1f94-4639-bc85-c80e0225a266" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="93223bc1-a324-4aa4-ba8c-1e4c96f202d0" data-undisplayed="undisplayed">knapsackBacktracking.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="222a7407-45b6-41a2-a501-2caa016d5dfc" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;
int n,w,value[100],weight[100],max=0;
void knapsack(int i,int currentw,int currentp)
{
	if(currentw&gt;w)
		return;
	if(currentp&gt;max)
		max=currentp;
	if(i==n)
		return;
	knapsack(i+1,currentw+weight[i],currentp+value[i]);
	knapsack(i+1,currentw,currentp);
}
int main()
{
	int i;
	scanf("%d",&amp;n);
	for(i=0;i&lt;n;i++)
		{
			scanf("%d %d",&amp;value[i],&amp;weight[i]);
		}
	scanf("%d",&amp;w);
	knapsack(0,0,0);
	printf("%d\n",max);
	return 0;
}
</pre><br data-ref="c14fcfd9-73d5-4484-b2c3-c5612330ecfb"></div></div><div class="row" data-ref="d04e8239-d201-43eb-bffe-ba998fc8e5ca"><div class="col-12" data-ref="3c6268d1-d4ec-464a-9ef1-8137caa469ef"><h5 class="execResultsHeading text-center" data-ref="f0c3bd8a-44ea-4bcc-8a0c-b74afd4f104d">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="c4bb3d33-12c9-4792-bab5-942d20580475" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="a2170f76-6865-40d8-804d-8431f4f62987"><div class="row execution-results-border" data-ref="dddfa940-822c-4f0a-b4f6-66bd20d9c265"><div class="col-12 p-2 text-center font-weight-bold" data-ref="92e2048c-8ae3-45d4-8c4f-07ac20f6e77c">Test Case - 1</div></div><div class="row execution-results-border" data-ref="77f846da-2fa9-438e-8731-bd914b296f7e"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="7e8eec9c-de30-43bd-b93e-74e17c1aa8f4">User Output</div></div><div class="row execution-results-border" data-ref="52b5be81-f6b8-44bf-827e-2d66bff0f66f"><div class="col-6" data-ref="e68bbbb8-a8d3-4bae-9d8d-6af450d05206"><span class="cmd" title="User Input" data-ref="3ecd748d-2ea1-4046-9c66-39800ef2291d">3</span></div></div><div class="row execution-results-border" data-ref="9d4bdd57-d68f-462a-98f9-abab59a22067"><div class="col-6" data-ref="be917836-af89-4cc1-aae2-b297d1f3198d"><span class="cmd" title="User Input" data-ref="6c25a1e2-7a92-43a3-bb83-a2e4c237ad26">60 10</span></div></div><div class="row execution-results-border" data-ref="39453d2a-603e-4b87-9bb5-31416443eb81"><div class="col-6" data-ref="b90e93ba-db22-42dd-85ed-cf8d046b078b"><span class="cmd" title="User Input" data-ref="b4b6f760-1e8c-4722-9a1c-e1fa1e93a2a1">100 20</span></div></div><div class="row execution-results-border" data-ref="4334bb18-1581-4bac-89fc-a17a032c79f2"><div class="col-6" data-ref="5296616b-a48a-478d-b761-d4c30f6ac116"><span class="cmd" title="User Input" dat