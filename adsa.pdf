int board[20][20],n;
int issafe(int row,int col)
{
	int i,j;
	for(i=0;i&lt;row;i++)
		{
		if(board[i][col]==1)
		return 0;
		}
for(i=row-1,j=col-1;i&gt;=0 &amp;&amp; j&gt;=0;i--,j--)
	{
		if(board[i][j]==1)
			return 0;
	}
for(i=row-1,j=col+1;i&gt;=0 &amp;&amp; j&lt;n;i--,j++)
{
	if(board[i][j]==1)
		return 0;
}
return 1;
}
int solve(int row)
{
	int col;
	if(row==n)
	{
		return 1;
	}
	for(col=0;col&lt;n;col++)
		{
			if(issafe(row,col))
			{
			board[row][col]=1;
				if(solve(row+1))
					return 1;
				board[row][col]=0;
			}
		}
	return 0;
}
int main()
{
