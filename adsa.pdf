				break;
			}
		}
}
void deleteMin()
{
	if(size==0)return;
	heap[0]=heap[size-1];
	size--;
	heapifyDown(0);
}
void printHeap()
{
	for(int i=0;i&lt;size;i++)
		{
			printf("%d ",heap[i]);
		}
}
int main()
{
	int n,del,val;
	scanf("%d",&amp;n);
	for(int i=0;i&lt;n;i++)
		{
			scanf("%d",&amp;val);
			insert(val);
		}
	printHeap();
	scanf("%d\n",&amp;del);
	for(int i=0;i&lt;del;i++)
		{
			deleteMin();
		}
	printHeap();
	printf("\n");
	return 0;
}</pre><br data-ref="0c76d6f2-bd38-43fa-b814-7141ed470b41"></div></div><div class="row" data-ref="93ba2328-e9d2-48e9-8501-783afcf72161"><div class="col-12" data-ref="1126d0a3-75e0-4091-84c1-a5d2d5ca1177"><h5 class="execResultsHeading text-center" data-ref="fb43ff06-3ff8-47f8-8f5e-ed2f82340c62">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="36155cec-6e65-44c7-81ea-3ee4d620f7c2" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div></div></div></div></div></div></div>
